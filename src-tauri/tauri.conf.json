{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitVista",
  "version": "0.1.0",
  "identifier": "io.gitvista.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "GitVista", "width": 1380, "height": 900, "minWidth": 800, "minHeight": 560, "backgroundColor": "#16181d", "titleBarStyle": "Overlay", "hiddenTitle": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:" }
  },
  "bundle": { "active": true, "targets": ["app"], "category": "DeveloperTool", "shortDescription": "Fast, focused Git review across nested repositories", "icon": ["icons/icon.icns", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"] }
}
